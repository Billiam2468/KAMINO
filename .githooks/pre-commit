#!/usr/bin/env python3
"""
Refuses a commit that looks like it contains patient data -- this repository
is public. Checks what's staged for:

- files that hold scans, segmentations or results (.nrrd, .nii, .nii.gz, .dcm,
  .zip, .csv, .pkl), review decisions (kneemeasure_review.json) or a mapping
  sheet (mrn_code_mapping);
- added lines with a number shaped like an MRN (7 digits starting with 1).

Turn it on once per clone:   git config core.hooksPath .githooks
A false alarm can be committed anyway with:   git commit --no-verify
"""
import re
import subprocess
import sys

DATA_FILE = re.compile(r'\.(nrrd|nii|nii\.gz|dcm|zip|csv|pkl)$|kneemeasure_review\.json$|mrn_code_mapping', re.I)
MRN = re.compile(r'(?<![\w.])1\d{6}(?![\w.])')


def git(*args):
    return subprocess.run(['git', *args], capture_output=True, text=True, check=True).stdout


problems = []
for path in git('diff', '--cached', '--name-only', '--diff-filter=ACMR').splitlines():
    if DATA_FILE.search(path):
        problems.append(f'{path}: looks like a data file (scan, segmentation, results or mapping sheet)')

current = None
for line in git('diff', '--cached', '-U0', '--diff-filter=ACMR', '--no-ext-diff').splitlines():
    if line.startswith('+++ '):
        current = line[6:] if line.startswith('+++ b/') else None
    elif line.startswith('+') and current and not DATA_FILE.search(current):
        for m in MRN.finditer(line):
            problems.append(f'{current}: "{m.group()}" looks like an MRN')

if problems:
    print('Commit stopped: this repository is public and these look like patient data.\n')
    for p in problems:
        print('  ' + p)
    print('\nRemove them (git restore --staged <file>), or if this is a false alarm: git commit --no-verify')
    sys.exit(1)
